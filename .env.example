# Browser-safe Supabase values. Find these in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Used only to build absolute email redirect URLs locally or in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add SUPABASE_SERVICE_ROLE_KEY to this application or commit it.
